# Pegwin Circle web — environment template (placeholders only, never real secrets).
# Copy to `.env.local` for local development. `.env*` files are git-ignored.

# Base URL of the Pegwin backend REST API (server-side only).
PEGWIN_API_BASE_URL=https://api.pegwin.in/api/v1

# Public app URL used for links/redirects (safe to expose).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: support contact shown on help pages.
SUPPORT_EMAIL=support@example.com

# Data source: sample data (mock) or live backend (api). Unset = api.
# Local development: mock. Production must use api (mock is refused there).
PEGWIN_DATA_SOURCE=mock

# Demo-only escape hatch: set to true ONLY on a throwaway hosted demo to serve
# sample data in production. Never enable on a real deployment.
# PEGWIN_ALLOW_DEMO_MOCK=true
